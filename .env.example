# Copy to .env.local for development, and set the same keys in the Vercel
# project (Settings → Environment Variables) for preview and production.

# Resend API key — delivers contact-form enquiries.
# WITHOUT THIS, every submitted enquiry shows the visitor an error in
# production. Locally, submissions are logged to the console instead.
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Envelope sender. Must be a verified domain in the Resend account.
# Defaults to website@infinium.technology if unset.
CONTACT_FROM=website@infinium.technology

# Where enquiries are delivered. Defaults to sales@infinium.technology.
CONTACT_TO=sales@infinium.technology
