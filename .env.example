# Copy to .env.local for development, and set the same keys in the Vercel
# project (Settings → Environment Variables) for preview and production.

# Formspree endpoint — delivers contact-form enquiries. Defaults to
# https://formspree.io/f/xrendqrr if unset; only set this to point at a
# different Formspree form (e.g. a staging form while testing).
FORMSPREE_ENDPOINT=
